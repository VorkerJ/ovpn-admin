FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN apk add --update --no-cache python3 make g++ && npm ci
COPY frontend/ ./
RUN npm run build

# golang:1.26-bookworm pulls Go 1.26.x, which patches a batch of reachable
# stdlib CVEs govulncheck flags against the prior 1.25 base — notably the
# HTTP/2 transport infinite-loop (GO-2026-4918) and the TLS 1.3 KeyUpdate
# connection-retention DoS (GO-2026-4870), both remotely reachable from the
# admin's HTTP server and the k8s client. Keep this current on the patch line.
FROM golang:1.26-bookworm AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend-builder /app/static ./frontend/static
# TARGETARCH is auto-set by BuildKit from --platform (defaults to host arch
# when no platform flag is passed). The ":-amd64" fallback covers the rare
# case where the builder doesn't set it. On Apple Silicon local builds this
# becomes arm64 so the binary doesn't fail cross-compile via gcc -m64.
ARG TARGETARCH
RUN env CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -a -tags netgo -ldflags '-linkmode external -extldflags -static -s -w' \
    -o ovpn-admin

FROM alpine:3.23
WORKDIR /app
COPY --from=backend-builder /app/ovpn-admin ./

# Pin openvpn-user version and verify SHA256 of the downloaded tarball.
# When bumping OPENVPN_USER_VERSION, recompute the SHA256:
#   curl -sL https://github.com/pashcovich/openvpn-user/releases/download/<ver>/openvpn-user-linux-amd64.tar.gz | sha256sum
ENV OPENVPN_USER_VERSION=v1.0.4
ENV OPENVPN_USER_SHA256=7abdd875142db72dcb985c1a7ec59b68a4bf40dea6aeb26ee37f582ee752e5d3

RUN apk add --update bash easy-rsa openssl openvpn coreutils iptables iptables-legacy libcap && \
    ln -s /usr/share/easy-rsa/easyrsa /usr/local/bin && \
    wget -q "https://github.com/pashcovich/openvpn-user/releases/download/${OPENVPN_USER_VERSION}/openvpn-user-linux-amd64.tar.gz" -O /tmp/ou.tgz && \
    echo "${OPENVPN_USER_SHA256}  /tmp/ou.tgz" | sha256sum -c - && \
    tar xz -C /usr/local/bin -f /tmp/ou.tgz && \
    rm /tmp/ou.tgz && \
    rm -rf /tmp/* /var/tmp/* /var/cache/apk/* /var/cache/distfiles/*
RUN addgroup -S ovpnadmin && \
    addgroup -g 2000 ovpnshared && \
    adduser -S -G ovpnadmin ovpnadmin && \
    adduser ovpnadmin ovpnshared && \
    chown -R ovpnadmin:ovpnadmin /app && \
    setcap cap_net_admin+ep /usr/sbin/xtables-nft-multi 2>/dev/null || true
USER ovpnadmin
