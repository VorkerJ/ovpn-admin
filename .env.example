# ───────────────────────────────────────────────────────────────────────
#  ovpn-admin — .env.example
#
#  Copy to `.env` and adjust before running `docker compose up -d`.
#  Every variable here has a sane default in docker-compose.yaml,
#  so an empty .env will still boot a working local stack.
# ───────────────────────────────────────────────────────────────────────

# ── Public endpoint ────────────────────────────────────────────────────
# What clients put in their .ovpn files.
# For a VPS deploy: set this to your public IP or DNS name.
OVPN_PUBLIC_HOSTNAME=127.0.0.1

# OpenVPN port (public, mapped to the container). UDP is recommended.
OVPN_PORT=1194
OVPN_PROTO=udp

# ── Admin UI exposure ──────────────────────────────────────────────────
# Default: bind admin UI only to 127.0.0.1 inside the host — NOT reachable
# from the internet. SSH-tunnel into the VPS to use it:
#     ssh -L 8080:127.0.0.1:8080 user@vps
# If you put a TLS-terminating reverse proxy in front, set
# OVPN_ADMIN_BIND=0.0.0.0 and configure ADMIN_HTPASSWD_FILE below.
OVPN_ADMIN_BIND=127.0.0.1
OVPN_ADMIN_PORT=8080

# ── Admin UI authentication ────────────────────────────────────────────
# Pin the admin password by mounting an htpasswd file. To enable:
#   1. Create the file:    htpasswd -cBb ./htpasswd admin <password>
#   2. Uncomment the htpasswd volume line in docker-compose.yaml.
#   3. Uncomment ADMIN_HTPASSWD_FILE below.
# When empty, ovpn-admin auto-generates a one-time password (see logs).
# ADMIN_HTPASSWD_FILE=/mnt/auth/htpasswd

# ── VPN subnet ─────────────────────────────────────────────────────────
# Internal VPN network handed to clients. Pick a private range that
# doesn't collide with your LAN.
OVPN_NETWORK_BASE=172.16.100.0
OVPN_NETWORK_MASK=255.255.255.0

# ── User-password auth for VPN clients (in addition to certificates) ───
# Set to "true" if you want clients to provide username+password on top
# of their certificate. Off by default.
OVPN_PASSWD_AUTH=false

# ── Server-side firewall (iptables) ────────────────────────────────────
# Default-deny per-client routing, enforced by ovpn-admin. Leave on.
OVPN_FIREWALL=true

# ── Log verbosity ──────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Persistent state paths (host side) ─────────────────────────────────
# Where to keep the CA, keys, CCD and other state. Defaults to bind-mounts
# in the project directory so backups are easy. Use absolute paths in
# production (e.g. /var/lib/ovpn-admin/easyrsa).
OVPN_EASYRSA_PATH=./easyrsa_master
OVPN_CCD_PATH=./ccd_master

# ── Image overrides (advanced) ─────────────────────────────────────────
# Point at pre-built images instead of rebuilding from source.
# OVPN_IMAGE=ghcr.io/yourorg/openvpn:latest
# OVPN_ADMIN_IMAGE=ghcr.io/yourorg/ovpn-admin:latest
