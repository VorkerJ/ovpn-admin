# ── openvpn-user builder ───────────────────────────────────────────────────
# Builds our native openvpn-user CLI (internal/ovpnuser) from source instead of
# downloading a third-party prebuilt binary. Pure-Go SQLite (modernc) → CGO off
# → a static binary that drops straight into the runtime image.
FROM golang:1.26-bookworm AS ou-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH
RUN env CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags '-s -w' -o /openvpn-user ./cmd/openvpn-user

# ── runtime ────────────────────────────────────────────────────────────────
FROM debian:trixie-slim
ARG TARGETARCH

# Debian trixie ships OpenVPN 2.6.x built WITH `--enable-dco`, so the
# data-channel-offload directive works out of the box once the kernel has
# the `ovpn` module loaded (mainline 6.16+) or an OOT `ovpn_dco` variant.
# Alpine's package is built WITHOUT DCO, which is why we used to default
# DCOEnabled=false. With this image, operators can flip DCO on in the UI.

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash openvpn easy-rsa iptables iproute2 ca-certificates && \
    ln -sf /usr/share/easy-rsa/easyrsa /usr/local/bin/easyrsa && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Our openvpn-user (same source as the ovpn-admin binary's openvpn-user mode).
COPY --from=ou-builder /openvpn-user /usr/local/bin/openvpn-user

COPY setup/ /etc/openvpn/setup
RUN chmod +x /etc/openvpn/setup/configure.sh
